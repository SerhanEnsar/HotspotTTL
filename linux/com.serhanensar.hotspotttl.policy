<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Hotspot TTL</vendor>
  <vendor_url>https://github.com/SerhanEnsar/HotspotTTL</vendor_url>
  <action id="com.serhanensar.hotspotttl.apply">
    <description>Hotspot TTL ağ ayarlarını değiştir</description>
    <message>Hotspot TTL'in ağ ayarlarını değiştirmek için yönetici şifresi gerekiyor</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/hotspot-ttl</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
